#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# live.py owns the omarchy-shell/hyprctl lifecycle, signal traps and finally cleanup.
# Its mktemp equivalent is tempfile.mkdtemp; backup and marker survive failed restoration.
exec /usr/bin/python3 "$root/demo/live.py" "$@"
